{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SysAdminDoc/SysAdminDoc/main/schemas/profile-catalog.v1.json",
  "title": "SysAdminDoc profile catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "entries"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^https://raw\\.githubusercontent\\.com/([A-Za-z0-9-]+)/\\1/main/schemas/profile-catalog\\.v1\\.json(?![\\s\\S])"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "portfolioUrl": {
      "$ref": "#/$defs/publicHttpsUrl"
    },
    "profileHeader": {
      "$ref": "#/$defs/profileHeader"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/catalogEntry"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "title",
        "category",
        "includeInReadme",
        "includeInPortfolio",
        "order",
        "branch",
        "entrypoint",
        "installKind",
        "downloadKind",
        "userscriptUrl",
        "liveUrl",
        "language",
        "descriptionOverride",
        "featured",
        "featuredRank",
        "currentlyBuilding",
        "currentlyBuildingText",
        "allowPublicMedical",
        "aliasOf",
        "suppressionReason",
        "notes"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(?![\\s\\S])"
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}(?![\\s\\S])"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+(?![\\s\\S])"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "enum": [
            "android",
            "desktop",
            "extensions",
            "guides",
            "media",
            "misc",
            "powershell",
            "python",
            "security",
            "suppressed",
            "web"
          ]
        },
        "includeInReadme": {
          "type": "boolean"
        },
        "includeInPortfolio": {
          "type": "boolean"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*(?![\\s\\S])"
        },
        "entrypoint": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9 ._()+-]*[\\\\/])*[A-Za-z0-9][A-Za-z0-9 ._()+-]*\\.(?:ps1|py|pyw)(?![\\s\\S])"
        },
        "installKind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "powershell",
            "python",
            null
          ]
        },
        "downloadKind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "apk",
            "crx",
            "crx-xpi",
            "download",
            "exe",
            "repo",
            "userscript",
            "zip",
            "zip-xpi",
            null
          ]
        },
        "userscriptUrl": {
          "$ref": "#/$defs/nullableCatalogUrl"
        },
        "liveUrl": {
          "$ref": "#/$defs/nullableCatalogUrl"
        },
        "language": {
          "$ref": "#/$defs/nullableString"
        },
        "localeHints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scriptHints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "descriptionOverride": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "featured": {
          "type": "boolean"
        },
        "featuredRank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "currentlyBuilding": {
          "type": "boolean"
        },
        "currentlyBuildingText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "allowPublicMedical": {
          "type": "boolean"
        },
        "forkOf": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 140,
          "pattern": "^[A-Za-z0-9-]+/(?!\\.\\.?(?![\\s\\S]))[A-Za-z0-9._-]+(?![\\s\\S])"
        },
        "upstreamLicense": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "aliasOf": {
          "$ref": "#/$defs/nullableString"
        },
        "suppressionReason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "readmeReviewNote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "publicHttpsUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[!#-&(-;=?-\\[\\]-{}~]+(?![\\s\\S])"
    },
    "nullableCatalogUrl": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048,
      "pattern": "^https?://[!#-&(-;=?-\\[\\]-{}~]+(?![\\s\\S])"
    },
    "profileHeader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tagline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "about": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "url"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "url": {
                "$ref": "#/$defs/publicHttpsUrl"
              }
            }
          }
        },
        "support": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "imageUrl",
            "imageAlt"
          ],
          "properties": {
            "url": {
              "$ref": "#/$defs/publicHttpsUrl"
            },
            "imageUrl": {
              "$ref": "#/$defs/publicHttpsUrl"
            },
            "imageAlt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        }
      }
    }
  }
}
