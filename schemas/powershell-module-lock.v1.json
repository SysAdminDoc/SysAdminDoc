{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SysAdminDoc/SysAdminDoc/main/schemas/powershell-module-lock.v1.json",
  "title": "SysAdminDoc PowerShell module lock",
  "description": "Reviewed PowerShell Gallery package bytes and expected Authenticode signers for every module the local validation lane imports. An exact version pin does not detect a changed same-version package, so validate-local.ps1 verifies the nupkg SHA-256 before extraction and the signer before import.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "note",
    "reviewedAt",
    "packageSource",
    "modules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "reviewedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "packageSource": {
      "type": "string",
      "format": "uri"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "packageUrl",
          "nupkgSha256",
          "signed",
          "expectedSigner",
          "lane"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "packageUrl": {
            "type": "string",
            "pattern": "^https://www\\.powershellgallery\\.com/api/v2/package/"
          },
          "nupkgSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "signed": {
            "type": "boolean"
          },
          "expectedSigner": {
            "type": "string",
            "description": "Exact Authenticode certificate subject, compared case-sensitively. Preserve non-ASCII characters verbatim; a transliterated subject is a different signer."
          },
          "lane": {
            "type": "string",
            "enum": [
              "default",
              "pester6-compatibility"
            ]
          }
        }
      }
    }
  }
}
