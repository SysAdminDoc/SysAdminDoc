# Supply-chain defaults for the local validation toolchain. Committed so every clone
# and every npm version gets them, not just the ones whose defaults happen to agree.

# Dependency lifecycle scripts do not run on install. The Shai-Hulud family moved to
# preinstall, which executes even when the install itself fails, so refusing to run
# them is the mitigation that does not depend on the payload being detected.
ignore-scripts=true

# Fail the advisory lane on high and critical findings rather than only reporting them.
audit-level=high

# Do not install a version published in the last day. Compromised releases are
# usually pulled within hours; npm supports this but leaves it off, and the local
# review lane is the only place this repository can enforce it.
# npm measures this in DAYS, not minutes: 1440 here meant a 1440-day cutoff, which
# refused every release newer than late 2022.
min-release-age=1
